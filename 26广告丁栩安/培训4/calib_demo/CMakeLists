cmake_minimum_required(VERSION 3.16)

project(calib_demo LANGUAGES CXX)

# C++17
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# 查找 OpenCV。若找不到，配置时传 -DOpenCV_DIR=<opencv>/build
find_package(OpenCV REQUIRED)

message(STATUS "OpenCV version: ${OpenCV_VERSION}")
message(STATUS "OpenCV include dirs: ${OpenCV_INCLUDE_DIRS}")
message(STATUS "OpenCV libraries: ${OpenCV_LIBS}")

add_executable(calib_demo main.cpp)
target_include_directories(calib_demo PRIVATE ${OpenCV_INCLUDE_DIRS})
target_link_libraries(calib_demo PRIVATE ${OpenCV_LIBS})

if(MSVC)
    # 源码是 UTF-8，避免中文注释在 GBK 代码页下被误读
    target_compile_options(calib_demo PRIVATE /utf-8 /W4)
endif()

# Windows 下 OpenCV 是动态库，把运行所需 DLL 复制到 exe 旁边，双击也能跑
if(WIN32)
    file(GLOB OPENCV_RUNTIME_DLLS "${OpenCV_DIR}/x64/*/bin/opencv_*.dll")
    list(FILTER OPENCV_RUNTIME_DLLS EXCLUDE REGEX "d\\.dll$")
    if(OPENCV_RUNTIME_DLLS)
        add_custom_command(TARGET calib_demo POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                ${OPENCV_RUNTIME_DLLS}
                "$<TARGET_FILE_DIR:calib_demo>"
            COMMENT "Copying OpenCV runtime DLLs"
        )
    endif()
endif()
