cmake_minimum_required(VERSION 3.16)

project(armor_demo LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(OpenCV REQUIRED)

message(STATUS "OpenCV version: ${OpenCV_VERSION}")
message(STATUS "OpenCV include dirs: ${OpenCV_INCLUDE_DIRS}")
message(STATUS "OpenCV libraries: ${OpenCV_LIBS}")

add_library(armor_core STATIC
    src/armor_detector.cpp
)

target_include_directories(armor_core PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}/include
    ${OpenCV_INCLUDE_DIRS}
)
target_link_libraries(armor_core PUBLIC ${OpenCV_LIBS})

add_executable(image_hsv src/image_hsv.cpp)
target_link_libraries(image_hsv PRIVATE armor_core)

add_executable(video_detect src/video_detect.cpp)
target_link_libraries(video_detect PRIVATE armor_core)

if(MSVC)
    target_compile_options(armor_core PRIVATE /utf-8 /W4)
    target_compile_options(image_hsv PRIVATE /utf-8 /W4)
    target_compile_options(video_detect PRIVATE /utf-8 /W4)
endif()

# 把示例图片和视频复制到每个 exe 旁边，方便从 build 目录运行
foreach(target_name image_hsv video_detect)
    add_custom_command(TARGET ${target_name} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_directory
            "${CMAKE_CURRENT_SOURCE_DIR}/assets"
            "$<TARGET_FILE_DIR:${target_name}>/assets"
        COMMENT "Copying assets for ${target_name}"
    )
endforeach()

# Windows 下复制 OpenCV 运行库
if(WIN32)
    file(GLOB OPENCV_RUNTIME_DLLS
        "${OpenCV_DIR}/x64/*/bin/opencv_*.dll"
    )
    list(FILTER OPENCV_RUNTIME_DLLS EXCLUDE REGEX "d\\.dll$")
    if(OPENCV_RUNTIME_DLLS)
        foreach(target_name image_hsv video_detect)
            add_custom_command(TARGET ${target_name} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    ${OPENCV_RUNTIME_DLLS}
                    "$<TARGET_FILE_DIR:${target_name}>"
                COMMENT "Copying OpenCV DLLs for ${target_name}"
            )
        endforeach()
    endif()
endif()
